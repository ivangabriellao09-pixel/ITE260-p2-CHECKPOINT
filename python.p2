 208); --primary-button-fill-color: var(--google-blue-300); --primary-butto=
n-text-color: var(--google-gray-900); --quiet-background-color: var(--backg=
round-color); --secondary-button-border-color: var(--google-gray-700); --se=
condary-button-fill-color: var(--google-gray-900); --secondary-button-hover=
-fill-color: rgb(48, 51, 57); --secondary-button-text-color: var(--google-b=
lue-300); --small-link-color: var(--google-blue-300); --text-color: var(--g=
oogle-gray-500); }
