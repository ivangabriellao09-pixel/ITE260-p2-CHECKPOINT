{ background: var(--google-blue-600); transform: translate(calc(-90% + 2em)=
, -50%); }

.slow-speed-option [type=3D"checkbox"]:checked:disabled + .slow-speed-toggl=
e::before { background: rgb(189, 193, 198); }

.slow-speed-option [type=3D"checkbox"]:checked:disabled + .slow-speed-toggl=
e::after { background: var(--google-gray-50); }

