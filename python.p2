.bb_wrapper { cursor: default; margin: 0px; box-sizing: content-box; }

.bb_wrapper div { margin: 0px; }

.bb_wrapper .bb-layer { position: absolute; top: 0px; left: 0px; width: 100=
%; height: 100%; overflow: hidden; pointer-events: none !important; }

