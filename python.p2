.qc-ad .quantcast-ad-div { margin: 0px; padding: 0px; border: 0px; width: 1=
00%; height: 100%; }

.qc-ad .quantcast-ad-div iframe { margin: 0px; padding: 0px; border: 0px; }

.qc-ad .qc-adchoices { display: block; position: absolute; width: 20px; hei=
ght: 15px; background: rgba(204, 204, 204, 0.6); z-index: 10000; color: rgb=
a(0, 0, 0, 0.5); font-family: "Arial Regular", Arial, sans-serif; font-size=
: 11px; text-decoration: none; }

.qc-ad .qc-adchoices.top-right { float: right; right: 0px; top: 0px; border=
-radius: 0px 0px 0px 8px; box-shadow: rgba(0, 0, 0, 0.4) -1px 1px 2px; }

.qc-ad .qc-adchoices.bottom-right { float: right; right: 0px; bottom: 0px; =
border-radius: 8px 0px 0px; box-shadow: rgba(0, 0, 0, 0.4) -1px -1px 2px; }

.qc-ad .qc-adchoices.top-left { float: left; left: 0px; top: 0px; border-ra=
dius: 0px 0px 8px; box-shadow: rgba(0, 0, 0, 0.4) 1px 1px 2px; }

.qc-ad .qc-adchoices.bottom-left { float: left; left: 0px; bottom: 0px; bor=
der-radius: 0px 8px 0px 0px; box-shadow: rgba(0, 0, 0, 0.4) 1px -1px 2px; }

.qc-ad .qc-adchoices:hover { width: 76px; }

.qc-ad .qc-adchoices .qc-adchoices-text { border: 0px; padding: 0px; margin=
: 2px 0px 3px 5px; float: left; line-height: 11px; display: none; }

.qc-ad .qc-adchoices .qc-adchoices-icon { padding: 0px; border: 0px; margin=
: 1px 2px 4px 0px; width: 13px; height: 13.7px; float: right; }

.qc-ad .qc-adchoices:hover .qc-adchoices-text { display: inline; }

@media only screen and (orientation: portrait) and (min-device-width: 901px=
), only screen and (orientation: landscape) and (min-device-width: 1281px) =
{
  .qc-ad .qc-adchoices-link { display: block; position: absolute; width: 20=
px; height: 15px; background: 0px center; z-index: 10000; }
  .qc-ad .qc-adchoices-link.top-right { float: right; right: 0px; top: 0px;=
 border-radius: 0px 0px 0px 8px; }
  .qc-ad .qc-adchoices-link.bottom-right { float: right; right: 0px; bottom=
: 0px; border-radius: 8px 0px 0px; }
  .qc-ad .qc-adchoices-link.top-left { float: left; left: 0px; top: 0px; bo=
rder-radius: 0px 0px 8px; }
  .qc-ad .qc-adchoices-link.bottom-left { float: left; left: 0px; bottom: 0=
px; border-radius: 0px 8px 0px 0px; }
  .qc-ad .qc-adchoices-link:hover { width: 76px; }
}

@media only screen and (orientation: portrait) and (max-device-width: 900px=
), only screen and (orientation: landscape) and (max-device-width: 1280px) =
{
  .qc-ad .qc-adchoices-link { display: block; position: absolute; width: 30=
px; height: 30px; background: 0px center; z-index: 10000; }
  .qc-ad .qc-adchoices-link.top-right { float: right; right: 0px; top: 0px;=
 border-radius: 0px 0px 0px 8px; }
  .qc-ad .qc-adchoices-link.bottom-right { float: right; right: 0px; bottom=
: 0px; border-radius: 8px 0px 0px; }
  .qc-ad .qc-adchoices-link.top-left { float: left; left: 0px; top: 0px; bo=
rder-radius: 0px 0px 8px; }
  .qc-ad .qc-adchoices-link.bottom-left { float: left; left: 0px; bottom: 0=
px; border-radius: 0px 8px 0px 0px; }
  .qc-ad .qc-adchoices-link:hover { width: 90px; }
}

.qc-ad .border-div { display: block; position: absolute; border: 1px solid =
rgba(204, 204, 204, 0.7); background: transparent; float: left; top: 0px; l=
eft: 0px; width: 100%; height: 100%; pointer-events: none; box-sizing: bord=
er-box; }

.qc-ad .border-red { border: 1px solid red; }
